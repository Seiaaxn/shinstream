extends layout

block content
  div(class="max-w-7xl mx-auto px-4 md:px-6 py-8")
    //- Breadcrumb
    nav(class="flex items-center gap-2 text-sm text-gray-600 mb-6")
      a(href="/" class="hover:text-green-400 transition-colors") Home
      svg(class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")
      span(class="text-gray-400 truncate")= anime.title

    //- Hero Section
    div(class="relative rounded-2xl overflow-hidden mb-8")
      //- Backdrop blur poster
      div(class="absolute inset-0")
        img(src=anime.poster alt="" class="w-full h-full object-cover scale-110 blur-2xl opacity-20" style="filter: blur(24px)")
        div(class="absolute inset-0 bg-gradient-to-r from-[#080d08] via-[#080d08]/80 to-transparent")
        div(class="absolute inset-0 bg-gradient-to-t from-[#080d08] via-transparent to-[#080d08]/30")
      
      //- Content
      div(class="relative p-6 md:p-8 flex flex-col md:flex-row gap-6 md:gap-8")
        //- Poster
        div(class="flex-shrink-0 mx-auto md:mx-0")
          div(class="relative group")
            div(class="absolute -inset-0.5 rounded-2xl opacity-50 blur-sm" style="background: linear-gradient(135deg, #16a34a, #22c55e)")
            img(src=anime.poster alt=anime.title class="relative w-44 sm:w-52 h-auto rounded-2xl shadow-2xl object-cover" onerror="this.onerror=null;this.src='https://placehold.co/300x450?text=No+Image'")
            //- Episode count badge
            if anime.episodes && anime.episodes.length > 0
              div(class="absolute -bottom-2 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-green-600 text-white text-xs font-bold whitespace-nowrap shadow-lg")= `${anime.episodes.length} Episode`

        //- Info
        div(class="flex-1 min-w-0")
          //- Title
          h1(class="text-2xl md:text-3xl font-bold text-white mb-3 leading-snug")= anime.title
          
          //- Status badges
          div(class="flex flex-wrap gap-2 mb-4")
            if anime.status
              span(class=`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold ${anime.status.toLowerCase().includes('ongoing') || anime.status.toLowerCase().includes('berlangsung') ? 'bg-green-900/60 text-green-300 border border-green-700/50' : 'bg-cyan-900/60 text-cyan-300 border border-cyan-700/50'}`)
                div(class=`w-1.5 h-1.5 rounded-full ${anime.status.toLowerCase().includes('ongoing') || anime.status.toLowerCase().includes('berlangsung') ? 'bg-green-400 animate-pulse' : 'bg-cyan-400'}`)
                span= anime.status
            if anime.rating
              span(class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-yellow-900/40 text-yellow-300 border border-yellow-700/30")
                svg(class="w-3 h-3 text-yellow-400" fill="currentColor" viewBox="0 0 20 20")
                  path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                span= anime.rating
            if anime.release_year
              span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white/5 text-gray-300 border border-white/10")= anime.release_year
            if anime.type
              span(class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-900/40 text-purple-300 border border-purple-700/30")= anime.type

          //- Genre pills
          if anime.genres && anime.genres.length > 0
            div(class="flex flex-wrap gap-1.5 mb-5")
              each genre in anime.genres
                a(href=`/genres/${genre.slug}` class="genre-chip px-3 py-1 rounded-full text-xs transition-all")= genre.slug || genre.name

          //- Synopsis
          if anime.synopsis
            div(class="mb-6")
              h3(class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2") Sinopsis
              div(id="synopsisContainer" class="relative")
                p(id="synopsisText" class="text-gray-300 text-sm leading-relaxed overflow-hidden" style="max-height: 100px")= anime.synopsis
                div(id="synopsisGradient" class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-[#080d08] to-transparent")
              button(id="synopsisToggle" class="text-green-400 text-xs mt-2 hover:text-green-300 transition-colors flex items-center gap-1")
                span(id="synopsisToggleText") Baca Selengkapnya
                svg(id="synopsisArrow" class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7")

          //- Details grid
          div(class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-6 text-sm")
            if anime.studio
              div(class="p-3 rounded-xl bg-white/5 border border-white/5")
                p(class="text-gray-600 text-xs mb-1") Studio
                p(class="text-gray-300 font-medium truncate")= anime.studio
            if anime.duration
              div(class="p-3 rounded-xl bg-white/5 border border-white/5")
                p(class="text-gray-600 text-xs mb-1") Durasi
                p(class="text-gray-300 font-medium")= anime.duration
            if anime.total_episodes
              div(class="p-3 rounded-xl bg-white/5 border border-white/5")
                p(class="text-gray-600 text-xs mb-1") Total Ep
                p(class="text-gray-300 font-medium")= anime.total_episodes
            if anime.season
              div(class="p-3 rounded-xl bg-white/5 border border-white/5")
                p(class="text-gray-600 text-xs mb-1") Season
                p(class="text-gray-300 font-medium")= anime.season
            if anime.source
              div(class="p-3 rounded-xl bg-white/5 border border-white/5")
                p(class="text-gray-600 text-xs mb-1") Sumber
                p(class="text-gray-300 font-medium")= anime.source
            if anime.score
              div(class="p-3 rounded-xl bg-white/5 border border-white/5")
                p(class="text-gray-600 text-xs mb-1") Score
                p(class="text-gray-300 font-medium")= anime.score

          //- Action buttons
          div(class="flex flex-wrap gap-2")
            if anime.episodes && anime.episodes.length > 0
              a(href=`/anime/${anime.slug}/episode/1` class="flex items-center gap-2 px-5 py-2.5 rounded-xl btn-green text-white text-sm font-semibold")
                svg(class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20")
                  path(d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z")
                span Tonton EP 1
            if anime.batch_links && anime.batch_links.length > 0
              a(href=`/anime/${anime.slug}/batch` class="flex items-center gap-2 px-5 py-2.5 rounded-xl border border-cyan-700/50 text-cyan-400 text-sm font-semibold hover:bg-cyan-900/20 transition-all")
                svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4")
                span Download Batch
            if currentUser
              button(
                id="bookmarkBtn"
                data-id=anime.id
                data-title=anime.title
                data-slug=anime.slug
                data-poster=anime.poster
                class="flex items-center gap-2 px-5 py-2.5 rounded-xl border border-green-900/40 text-gray-400 text-sm hover:text-green-400 hover:border-green-700/50 transition-all"
              )
                svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z")
                span Bookmark

    //- Episodes List
    if anime.episodes && anime.episodes.length > 0
      div(class="mb-8")
        div(class="flex items-center justify-between mb-4")
          div(class="flex items-center gap-3")
            div(class="section-bar")
            h2(class="text-lg font-bold text-white") Daftar Episode
          span(class="text-gray-600 text-sm")= `${anime.episodes.length} Episode`

        //- Episode search
        if anime.episodes.length > 12
          div(class="mb-4")
            input(
              type="text"
              id="episodeSearch"
              placeholder="Cari episode..."
              class="w-full sm:w-64 px-4 py-2 bg-white/5 border border-green-900/30 rounded-lg text-sm text-gray-300 placeholder-gray-600 focus:outline-none focus:border-green-600/40 transition-all"
            )

        div(id="episodeGrid" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6 xl:grid-cols-8 gap-2")
          each episode in anime.episodes
            a(href=`/anime/${anime.slug}/episode/${episode.episode_number || episode.number}` class="episode-item group flex items-center justify-center p-3 rounded-xl border border-green-900/20 bg-[#0d150d] hover:border-green-700/40 hover:bg-green-900/15 transition-all duration-200 text-center")
              div
                p(class="text-xs font-semibold text-gray-400 group-hover:text-green-400 transition-colors")= `EP ${episode.episode_number || episode.number}`
                if episode.title && episode.title !== `Episode ${episode.episode_number}`
                  p(class="text-xs text-gray-600 line-clamp-1 mt-0.5")= episode.title

    //- Batch download
    if anime.batch_links && anime.batch_links.length > 0
      div(class="mb-8")
        div(class="flex items-center gap-3 mb-4")
          div(class="section-bar" style="background: linear-gradient(to bottom, #0891b2, #06b6d4)")
          h2(class="text-lg font-bold text-white") Download Batch
        div(class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3")
          each batch in anime.batch_links
            a(href=batch.url || batch target="_blank" rel="noopener" class="flex items-center gap-3 p-4 rounded-xl border border-cyan-900/30 bg-cyan-900/10 hover:border-cyan-700/50 hover:bg-cyan-900/20 transition-all group")
              div(class="w-9 h-9 rounded-xl bg-cyan-900/40 flex items-center justify-center flex-shrink-0 group-hover:bg-cyan-800/50 transition-all")
                svg(class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                  path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4")
              div
                p(class="text-sm font-medium text-cyan-300")= batch.quality || batch.resolution || 'Download'
                p(class="text-xs text-gray-600")= batch.size || 'Batch'

  block scripts
    script.
      // Synopsis toggle
      const synText = document.getElementById('synopsisText');
      const synGrad = document.getElementById('synopsisGradient');
      const synToggle = document.getElementById('synopsisToggle');
      const synToggleText = document.getElementById('synopsisToggleText');
      const synArrow = document.getElementById('synopsisArrow');
      let synExpanded = false;
      if (synText && synText.scrollHeight <= 100) {
        if(synToggle) synToggle.style.display = 'none';
        if(synGrad) synGrad.style.display = 'none';
      }
      synToggle?.addEventListener('click', () => {
        synExpanded = !synExpanded;
        synText.style.maxHeight = synExpanded ? 'none' : '100px';
        synGrad.style.display = synExpanded ? 'none' : 'block';
        synToggleText.textContent = synExpanded ? 'Sembunyikan' : 'Baca Selengkapnya';
        synArrow.style.transform = synExpanded ? 'rotate(180deg)' : '';
      });

      // Episode search
      const epSearch = document.getElementById('episodeSearch');
      epSearch?.addEventListener('input', function() {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.episode-item').forEach(item => {
          item.style.display = item.textContent.toLowerCase().includes(q) ? '' : 'none';
        });
      });
