extends layout

block content
  div(class="max-w-7xl mx-auto px-4 md:px-6 py-8")
    //- Header
    div(class="mb-8")
      div(class="flex items-center gap-3 mb-2")
        div(class="section-bar")
        h1(class="text-2xl font-bold text-white") Explore Anime
      p(class="text-gray-500 text-sm ml-4") Temukan anime ongoing, genre, dan lebih banyak lagi

    //- Filter Tabs
    div(class="flex items-center gap-2 flex-wrap mb-6")
      a(href="/explore" class=`px-4 py-2 rounded-lg text-sm font-medium transition-all ${!currentFilter || currentFilter === 'all' ? 'btn-green text-white' : 'border border-green-900/30 text-gray-400 hover:text-green-400 hover:border-green-700/40'}`) Semua
      a(href="/explore?filter=ongoing" class=`px-4 py-2 rounded-lg text-sm font-medium transition-all ${currentFilter === 'ongoing' ? 'btn-green text-white' : 'border border-green-900/30 text-gray-400 hover:text-green-400 hover:border-green-700/40'}`) Ongoing
      a(href="/explore?filter=complete" class=`px-4 py-2 rounded-lg text-sm font-medium transition-all ${currentFilter === 'complete' ? 'btn-green text-white' : 'border border-green-900/30 text-gray-400 hover:text-green-400 hover:border-green-700/40'}`) Complete
      a(href="/genres" class="px-4 py-2 rounded-lg text-sm font-medium border border-green-900/30 text-gray-400 hover:text-green-400 hover:border-green-700/40 transition-all") Browse Genre

    //- Search and results
    if animeList && animeList.length > 0
      div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 md:gap-4 mb-8")
        each anime in animeList
          div(class="anime-card group")
            a(href=`/anime/${anime.slug}`)
              div(class="card-inner relative rounded-xl overflow-hidden border border-green-900/20 bg-[#0d150d] transition-all duration-300")
                div(class="relative overflow-hidden aspect-[2/3]")
                  img(src=anime.poster alt=anime.title class="card-img w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/300x450?text=No+Image'")
                  div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                  if anime.current_episode
                    div(class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-xs font-bold bg-green-600/90 text-white")= anime.current_episode
                  else if anime.status === 'Complete' || anime.status === 'Completed'
                    div(class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-xs font-bold bg-cyan-600/90 text-white") Selesai
                  if anime.rating
                    div(class="absolute bottom-2 left-2 flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-black/70 text-yellow-400 text-xs")
                      svg(class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20")
                        path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                      span= anime.rating
                  div(class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                    div(class="w-10 h-10 bg-green-500/90 rounded-full flex items-center justify-center")
                      svg(class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20")
                        path(d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z")
                div(class="p-2.5")
                  h3(class="text-xs font-medium text-gray-300 line-clamp-2 leading-snug")= anime.title
                  if anime.newest_release_date
                    p(class="text-xs text-gray-600 mt-1")= anime.newest_release_date
      //- Pagination
      if pagination && pagination.last_visible_page > 1
        nav(class="flex justify-center gap-2")
          if pagination.current_page > 1
            a(href=`/explore?page=${pagination.current_page - 1}${currentFilter ? '&filter='+currentFilter : ''}` class="px-3 py-2 rounded-lg border border-green-900/30 text-gray-400 hover:text-green-400 hover:border-green-700/40 text-sm transition-all") ← Prev
          each page in Array.from({length: Math.min(7, pagination.last_visible_page)}, (_, i) => { const start = Math.max(1, pagination.current_page - 3); return start + i; }).filter(p => p <= pagination.last_visible_page)
            if page === pagination.current_page
              span(class="px-3 py-2 rounded-lg btn-green text-white text-sm font-medium")= page
            else
              a(href=`/explore?page=${page}${currentFilter ? '&filter='+currentFilter : ''}` class="px-3 py-2 rounded-lg border border-green-900/30 text-gray-400 hover:text-green-400 hover:border-green-700/40 text-sm transition-all")= page
          if pagination.current_page < pagination.last_visible_page
            a(href=`/explore?page=${pagination.next_page}${currentFilter ? '&filter='+currentFilter : ''}` class="px-3 py-2 rounded-lg border border-green-900/30 text-gray-400 hover:text-green-400 hover:border-green-700/40 text-sm transition-all") Next →
    else
      div(class="text-center py-16")
        div(class="w-16 h-16 rounded-2xl bg-green-900/20 border border-green-900/30 flex items-center justify-center mx-auto mb-4")
          svg(class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
        p(class="text-gray-500") Tidak ada anime ditemukan
