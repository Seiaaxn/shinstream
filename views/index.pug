extends layout

block content
  //- Hero Section
  section(class="relative overflow-hidden py-14 md:py-20")
    //- Background gradient
    div(class="absolute inset-0 bg-gradient-to-b from-green-950/30 via-transparent to-transparent")
    div(class="absolute top-0 left-1/4 w-96 h-96 bg-green-600/5 rounded-full blur-[100px]")
    div(class="absolute top-10 right-1/3 w-64 h-64 bg-green-500/5 rounded-full blur-[80px]")
    div(class="max-w-7xl mx-auto px-4 md:px-6 relative")
      div(class="max-w-2xl")
        div(class="inline-flex items-center gap-2 px-3 py-1.5 bg-green-900/30 border border-green-800/40 rounded-full text-green-400 text-xs font-medium mb-5")
          div(class="w-1.5 h-1.5 bg-green-400 rounded-full animate-pulse")
          span Anime terbaru tersedia setiap hari
        h1(class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight")
          | Nonton Anime
          span(class="block" style="background: linear-gradient(135deg, #4ade80, #22c55e, #16a34a); -webkit-background-clip: text; -webkit-text-fill-color: transparent;") Sub Indo Gratis
        p(class="text-gray-400 text-base md:text-lg mb-7 leading-relaxed max-w-lg") Ribuan judul anime dengan subtitle Indonesia berkualitas. Update cepat, streaming lancar tanpa iklan mengganggu.
        div(class="flex flex-wrap gap-3")
          a(href="/explore" class="flex items-center gap-2 px-5 py-2.5 rounded-xl btn-green text-white font-semibold text-sm")
            svg(class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20")
              path(d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z")
            span Jelajahi Anime
          a(href="/schedule" class="flex items-center gap-2 px-5 py-2.5 rounded-xl border border-green-800/40 text-green-400 text-sm font-medium hover:bg-green-900/20 transition-all")
            svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z")
            span Jadwal Tayang
      //- Stats
      div(class="flex items-center gap-6 mt-10")
        div
          p(class="text-2xl font-bold text-white") 5000+
          p(class="text-gray-600 text-xs") Judul Anime
        div(class="w-px h-10 bg-green-900/40")
        div
          p(class="text-2xl font-bold text-white") 100K+
          p(class="text-gray-600 text-xs") Penonton
        div(class="w-px h-10 bg-green-900/40")
        div
          p(class="text-2xl font-bold text-white") Update
          p(class="text-gray-600 text-xs") Setiap Hari

  //- Main content
  div(class="max-w-7xl mx-auto px-4 md:px-6 pb-16")

    //- Ongoing Terbaru
    if ongoingAnime && ongoingAnime.length > 0
      section(class="mb-12")
        div(class="flex items-center justify-between mb-6")
          div(class="flex items-center")
            div(class="section-bar")
            div
              h2(class="text-xl font-bold text-white") Ongoing Terbaru
              p(class="text-gray-600 text-xs mt-0.5") Anime yang sedang tayang
          a(href="/explore" class="flex items-center gap-1.5 text-green-400 text-sm hover:text-green-300 transition-colors")
            span Lihat Semua
            svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")
        div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 md:gap-4")
          each anime in ongoingAnime.slice(0, 12)
            div(class="anime-card group")
              a(href=`/anime/${anime.slug}`)
                div(class="card-inner relative rounded-xl overflow-hidden border border-green-900/20 bg-[#0d150d] transition-all duration-300")
                  div(class="relative overflow-hidden aspect-[2/3]")
                    img(src=anime.poster alt=anime.title class="card-img w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/300x450?text=No+Image'")
                    //- Gradient overlay
                    div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                    //- Episode badge
                    if anime.current_episode
                      div(class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-xs font-bold bg-green-600/90 text-white backdrop-blur-sm")= anime.current_episode
                    //- Date badge
                    if anime.newest_release_date
                      div(class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded-md text-xs bg-black/70 text-gray-300 border border-white/10")= anime.newest_release_date
                    //- Play icon on hover
                    div(class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                      div(class="w-10 h-10 bg-green-500/90 rounded-full flex items-center justify-center")
                        svg(class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20")
                          path(d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z")
                  div(class="p-2.5")
                    h3(class="text-xs font-medium text-gray-300 line-clamp-2 leading-snug")= anime.title

    //- Complete Terbaru
    if completeAnime && completeAnime.length > 0
      section(class="mb-12")
        div(class="flex items-center justify-between mb-6")
          div(class="flex items-center")
            div(class="section-bar" style="background: linear-gradient(to bottom, #0891b2, #06b6d4)")
            div
              h2(class="text-xl font-bold text-white") Anime Selesai Terbaru
              p(class="text-gray-600 text-xs mt-0.5") Telah tamat, siap ditonton penuh
          a(href="/complete" class="flex items-center gap-1.5 text-green-400 text-sm hover:text-green-300 transition-colors")
            span Lihat Semua
            svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7")
        div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 md:gap-4")
          each anime in completeAnime.slice(0, 12)
            div(class="anime-card group")
              a(href=`/anime/${anime.slug}`)
                div(class="card-inner relative rounded-xl overflow-hidden border border-green-900/20 bg-[#0d150d] transition-all duration-300")
                  div(class="relative overflow-hidden aspect-[2/3]")
                    img(src=anime.poster alt=anime.title class="card-img w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/300x450?text=No+Image'")
                    div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                    div(class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-xs font-bold bg-cyan-600/90 text-white") Selesai
                    if anime.rating
                      div(class="absolute bottom-2 left-2 flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-black/70 text-yellow-400 text-xs border border-white/10")
                        svg(class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20")
                          path(d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z")
                        span= anime.rating
                    div(class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                      div(class="w-10 h-10 bg-cyan-500/90 rounded-full flex items-center justify-center")
                        svg(class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20")
                          path(d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z")
                  div(class="p-2.5")
                    h3(class="text-xs font-medium text-gray-300 line-clamp-2 leading-snug")= anime.title
