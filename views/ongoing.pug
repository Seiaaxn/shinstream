extends layout

block content
  div(class="max-w-7xl mx-auto px-4 md:px-6 py-8")
    div(class="flex items-center gap-3 mb-6")
      div(class="section-bar")
      div
        h1(class="text-xl font-bold text-white") Anime Ongoing
        p(class="text-gray-500 text-xs mt-0.5") Anime yang sedang tayang dengan subtitle Indonesia
    if animeList && animeList.length > 0
      div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 md:gap-4 mb-8")
        each anime in animeList
          div(class="anime-card group")
            a(href=`/anime/${anime.slug}`)
              div(class="card-inner relative rounded-xl overflow-hidden border border-green-900/20 bg-[#0d150d] transition-all duration-300")
                div(class="relative overflow-hidden aspect-[2/3]")
                  img(src=anime.poster alt=anime.title class="card-img w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/300x450?text=No+Image'")
                  div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                  if anime.current_episode
                    div(class="absolute top-2 left-2 px-2 py-0.5 rounded-md text-xs font-bold bg-green-600/90 text-white")= anime.current_episode
                  if anime.newest_release_date
                    div(class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded-md text-xs bg-black/70 text-gray-300 border border-white/10")= anime.newest_release_date
                  div(class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                    div(class="w-10 h-10 bg-green-500/90 rounded-full flex items-center justify-center")
                      svg(class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20")
                        path(d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z")
                div(class="p-2.5")
                  h3(class="text-xs font-medium text-gray-300 line-clamp-2 leading-snug")= anime.title
      if pagination && pagination.last_visible_page > 1
        nav(class="flex justify-center gap-2")
          if pagination.current_page > 1
            a(href=`/ongoing?page=${pagination.current_page - 1}` class="px-3 py-2 rounded-lg border border-green-900/30 text-gray-400 hover:text-green-400 text-sm transition-all") ← Prev
          each page in Array.from({length: Math.min(7, pagination.last_visible_page)}, (_, i) => { const start = Math.max(1, pagination.current_page - 3); return start + i; }).filter(p => p <= pagination.last_visible_page)
            if page === pagination.current_page
              span(class="px-3 py-2 rounded-lg btn-green text-white text-sm font-medium")= page
            else
              a(href=`/ongoing?page=${page}` class="px-3 py-2 rounded-lg border border-green-900/30 text-gray-400 hover:text-green-400 text-sm transition-all")= page
          if pagination.current_page < pagination.last_visible_page
            a(href=`/ongoing?page=${pagination.next_page}` class="px-3 py-2 rounded-lg border border-green-900/30 text-gray-400 hover:text-green-400 text-sm transition-all") Next →
    else
      div(class="text-center py-16")
        p(class="text-gray-500") Tidak ada anime ongoing saat ini
