extends layout

block content
  div(class="max-w-7xl mx-auto px-4 md:px-6 py-8")
    //- Header
    div(class="mb-7")
      div(class="flex items-center gap-3 mb-4")
        div(class="section-bar")
        h1(class="text-xl font-bold text-white")
          if keyword
            | Hasil: "#{keyword}"
          else
            | Cari Anime
      //- Search form
      form(action="/search" method="GET" class="flex gap-3 max-w-xl")
        div(class="flex-1 relative")
          div(class="absolute inset-y-0 left-3 flex items-center pointer-events-none")
            svg(class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
          input(
            type="text" name="q"
            placeholder="Masukkan judul anime..."
            value=keyword || ""
            class="w-full pl-9 pr-4 py-2.5 bg-white/5 border border-green-900/30 rounded-xl text-sm text-gray-300 placeholder-gray-600 focus:outline-none focus:border-green-600/40 transition-all"
            autofocus
          )
        button(type="submit" class="px-5 py-2.5 rounded-xl btn-green text-white text-sm font-semibold") Cari
      if keyword && searchResults
        p(class="text-gray-600 text-sm mt-2")= `${searchResults.length} hasil ditemukan`
    //- Results
    if searchResults && searchResults.length > 0
      div(class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3 md:gap-4")
        each anime in searchResults
          div(class="anime-card group")
            a(href=`/anime/${anime.slug}`)
              div(class="card-inner relative rounded-xl overflow-hidden border border-green-900/20 bg-[#0d150d] transition-all duration-300")
                div(class="relative overflow-hidden aspect-[2/3]")
                  img(src=anime.poster alt=anime.title class="card-img w-full h-full object-cover" loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/300x450?text=No+Image'")
                  div(class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                  if anime.status
                    div(class=`absolute top-2 left-2 px-2 py-0.5 rounded-md text-xs font-bold ${anime.status === 'Ongoing' ? 'bg-green-600/90' : 'bg-cyan-600/90'} text-white`)= anime.status
                  div(class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300")
                    div(class="w-10 h-10 bg-green-500/90 rounded-full flex items-center justify-center")
                      svg(class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 20 20")
                        path(d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z")
                div(class="p-2.5")
                  h3(class="text-xs font-medium text-gray-300 line-clamp-2 leading-snug")= anime.title
                  if anime.release_year
                    p(class="text-xs text-gray-600 mt-0.5")= anime.release_year
    else if keyword
      div(class="text-center py-16")
        div(class="w-16 h-16 rounded-2xl bg-green-900/20 border border-green-900/30 flex items-center justify-center mx-auto mb-4")
          svg(class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
        p(class="text-gray-400 font-medium mb-1") Tidak ada hasil
        p(class="text-gray-600 text-sm")= `Anime "${keyword}" tidak ditemukan`
    else
      div(class="text-center py-16 text-gray-600")
        svg(class="w-12 h-12 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
          path(stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
        p Ketik judul anime untuk mencari
          
